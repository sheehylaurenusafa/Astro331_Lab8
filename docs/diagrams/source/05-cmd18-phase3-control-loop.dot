digraph G {
  layout=neato; splines=true; overlap=false;
  graph [fontname="Inter" fontsize=22 bgcolor="white" pad=0.3 nodesep=0.35 ranksep=0.45 ];
  node  [fontname="Inter" fontsize=20 margin="0.18,0.08"];
  edge  [fontname="Inter" color="#404040" penwidth=2 arrowsize=0.9];
  TGT [shape=box style="filled,rounded" fillcolor="#DCEFF8" color="#0F9ED5" fontcolor="#0E2841" penwidth=2 label=<<B>target heading</B><BR/><FONT POINT-SIZE="17">from phase 2 calibration</FONT>> ];
  HDG [shape=box style="filled,rounded" fillcolor="#DCEFF8" color="#0F9ED5" fontcolor="#0E2841" penwidth=2 label=<<FONT FACE="JetBrains Mono" POINT-SIZE="20"><B>lab8_mag_heading()</B></FONT><BR/><FONT POINT-SIZE="17">filtered mag X, Y</FONT>> ];
  IMU [shape=box style="filled,rounded" fillcolor="#DCEFF8" color="#0F9ED5" fontcolor="#0E2841" penwidth=2 label=<<FONT FACE="JetBrains Mono" POINT-SIZE="20"><B>lab8_read_imu()</B></FONT><BR/><FONT POINT-SIZE="17">rate = gyro_Z − bias, filtered</FONT>> ];
  E1 [shape=box style="filled,rounded" fillcolor="#FCE6D8" color="#E97132" fontcolor="#0E2841" penwidth=2 label=<<FONT FACE="JetBrains Mono" POINT-SIZE="20"><B>lab8_wrap180()</B></FONT><BR/><FONT POINT-SIZE="17">err = (target − heading)</FONT><BR/><FONT POINT-SIZE="17">× MAG_HEADING_SIGN</FONT>> ];
  PD [shape=box style="filled,rounded" fillcolor="#FCE6D8" color="#E97132" fontcolor="#0E2841" penwidth=2 label=<<B>Heading PD → wanted body accel</B><BR/><FONT POINT-SIZE="17">a_des = 0.5·err − 1.2·rate</FONT><BR/><FONT POINT-SIZE="17">(WHL_KP, WHL_KD)</FONT>> ];
  FF [shape=box style="filled,rounded" fillcolor="#FCE6D8" color="#E97132" fontcolor="#0E2841" penwidth=2 label=<<B>Cancel fan torque → wheel accel</B><BR/><FONT POINT-SIZE="17">ẇ = (a_des − α·fan_state) / 0.12</FONT><BR/><FONT POINT-SIZE="17">clamp ±30 RPM/s  (WHL_COUPLING)</FONT>> ];
  INT [shape=box style="filled,rounded" fillcolor="#FCE6D8" color="#E97132" fontcolor="#0E2841" penwidth=2 label=<<B>RW speed target</B><BR/><FONT POINT-SIZE="17">w_target += ẇ·dt</FONT>> ];
  TR [shape=box style="filled,rounded" fillcolor="#FCE6D8" color="#E97132" fontcolor="#0E2841" penwidth=2 label=<<B>Speed trim (integral)</B><BR/><FONT POINT-SIZE="17">w_trim += 2·(w_target − rpm_f)·dt</FONT><BR/><FONT POINT-SIZE="17">clamp ±150 RPM</FONT>> ];
  LUT [shape=box style="filled,rounded" fillcolor="#FCE6D8" color="#E97132" fontcolor="#0E2841" penwidth=2 label=<<FONT FACE="JetBrains Mono" POINT-SIZE="20"><B>lab8_rw_pwm_from_rpm()</B></FONT><BR/><FONT POINT-SIZE="17">(w_target + w_trim) → PWM</FONT><BR/><FONT POINT-SIZE="17">via RW_TABLE speed curve</FONT>> ];
  DRV [shape=box style="filled,rounded" fillcolor="#DDF0D5" color="#196B24" fontcolor="#0E2841" penwidth=2 label=<<FONT FACE="JetBrains Mono" POINT-SIZE="20"><B>driver.setOutput(rw_pwm)</B></FONT><BR/><FONT POINT-SIZE="17">TB9051FTG → reaction wheel</FONT>> ];
  FAN [shape=box style="filled,rounded" fillcolor="#DDF0D5" color="#196B24" fontcolor="#0E2841" penwidth=2 label=<<FONT FACE="JetBrains Mono" POINT-SIZE="20"><B>thrusters_set(+1)</B></FONT><BR/><FONT POINT-SIZE="17">+Z fan on full all phase</FONT>> ];
  SAT [shape=box style="filled,rounded" fillcolor="#0E2841" color="#0E2841" fontcolor="#FFFFFF" penwidth=2 label=<<B>KestrelSAT body</B><BR/><FONT POINT-SIZE="17">fan torque vs. wheel reaction</FONT>> ];
  ENC [shape=box style="filled,rounded" fillcolor="#DCEFF8" color="#0F9ED5" fontcolor="#0E2841" penwidth=2 label=<<FONT FACE="JetBrains Mono" POINT-SIZE="20"><B>lab8_measure_RW_rpm()</B></FONT><BR/><FONT POINT-SIZE="17">rpm_f = |RPM|, filtered</FONT>> ];
  NOTE [shape=box style="filled,rounded" fillcolor="#FFFFFF" color="#9FB3C8" fontcolor="#404040" penwidth=2 label=<<B>Why the wheel slows</B><BR/><FONT POINT-SIZE="17">IMU and magnetometer see the body motion and close the loop every 50 ms.</FONT><BR/><FONT POINT-SIZE="17">The fan torque is steady, so the wheel can only hold the heading</FONT><BR/><FONT POINT-SIZE="17">by slowing down, which drains its stored momentum.</FONT>> ];
  TGT -> E1 [ ];
  HDG -> E1 [ ];
  E1 -> PD [ ];
  PD -> FF [ ];
  FF -> INT [ ];
  INT -> TR [ ];
  TR -> LUT [ ];
  LUT -> DRV [ ];
  ENC -> TR [ label=<<FONT POINT-SIZE="17"><B>rpm_f</B></FONT>> ];
  IMU -> PD [ label=<<FONT POINT-SIZE="17"><B>rate</B></FONT>> ];
  DRV -> SAT [ ];
  FAN -> SAT [ ];
  FAN -> FF [label=<<FONT POINT-SIZE="16"><B>fan_state</B></FONT>> style=dashed color="#196B24" constraint=false];
  DRV -> ENC [style=dashed color="#0F9ED5" label=<<FONT POINT-SIZE="16"><B>encoder</B></FONT>>];
  TGT [pos="0,500!"];
  HDG [pos="440,500!"];
  IMU [pos="880,500!"];
  E1 [pos="0,375!"];
  PD [pos="440,375!"];
  FF [pos="880,375!"];
  ENC [pos="0,250!"];
  TR [pos="440,250!"];
  INT [pos="880,250!"];
  DRV [pos="0,125!"];
  LUT [pos="440,125!"];
  SAT [pos="0,0!"];
  FAN [pos="440,0!"];
  NOTE [pos="968,125!"];
}
